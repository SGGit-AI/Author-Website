@page
@model IndexModel
@{
    ViewData["Title"] = "Subhajit Ghosh | Author";
}

<section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
        <p class="eyebrow" data-copy="heroEyebrow">A writer across disciplines</p>
        <h1 id="hero-title">Subhajit<br /><span>Ghosh</span></h1>
        <p class="hero-intro" data-copy="heroIntro">AI. Leadership. Thriller. Horror. Explore ideas for the future and stories that stay with you after the last page.</p>
        <div class="hero-actions">
            <a class="button button-dark" asp-page="/Books" data-copy="exploreBooks">Explore the books <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#faq" data-copy="askFaq">Ask the book guide <span aria-hidden="true">↓</span></a>
        </div>
        <p class="draft-note" data-copy="draftNote">This site is being prepared. Book details, covers, and biography will be added when supplied by the author.</p>
    </div>
    <aside class="portrait-placeholder" aria-label="Author portrait">
        <div class="portrait-frame"><img src="/images/Subhajit_LinkedIn_Image.png" alt="Subhajit Ghosh" /></div>
        <span class="vertical-note" data-copy="portraitSideNote">OFFICIAL AUTHOR SITE · EST. 2026</span>
    </aside>
    <div class="hero-stamp" aria-hidden="true">WORDS<br />WORTH<br /><b>WANDERING</b></div>
</section>

<section class="genre-strip" aria-label="Writing categories">
    <div class="wrap genre-strip-inner">
        <span data-copy="writingAcross">Writing across</span>
        <a asp-page="/Books" asp-route-category="AI">AI <b>01</b></a>
        <a asp-page="/Books" asp-route-category="Leadership" data-copy="leadershipLink">Leadership <b>02</b></a>
        <a asp-page="/Books" asp-route-category="Thriller">Thriller <b>03</b></a>
        <a asp-page="/Books" asp-route-category="Horror">Horror <b>04</b></a>
    </div>
</section>

<section class="section wrap bookshelf" id="bookshelf" aria-labelledby="bookshelf-title">
    <div class="section-heading">
        <div><p class="eyebrow" data-copy="booksEyebrow">The bookshelf</p><h2 id="bookshelf-title" data-copy="booksTitle">Four doors.<br /><em>Many worlds.</em></h2></div>
        <a class="text-link" asp-page="/Books" data-copy="allBooks">Browse all books <span aria-hidden="true">↗</span></a>
    </div>
    <div class="shelf-grid">
        <a class="shelf-tile shelf-ai" asp-page="/Books" asp-route-category="AI"><span class="tile-number" data-copy="nonfictionOne">01 / NONFICTION</span><span class="tile-title">AI</span><span class="shelf-confirmed-title" data-copy="aiBookTitle">The AI Circuit Breaker</span><span class="tile-bottom" data-copy="viewAiBook">View book details <b aria-hidden="true">↗</b></span></a>
        <a class="shelf-tile shelf-leadership" asp-page="/Books" asp-route-category="Leadership"><span class="tile-number" data-copy="nonfictionTwo">02 / NONFICTION</span><span class="tile-title tile-title-long" data-copy="leadership">Leadership</span><span class="tile-bottom" data-copy="detailsPending">Titles and details to come <b aria-hidden="true">↗</b></span></a>
        <a class="shelf-tile shelf-thriller" asp-page="/Books" asp-route-category="Thriller"><span class="tile-number" data-copy="fictionThree">03 / FICTION</span><span class="tile-title tile-title-long" data-copy="thriller">Thriller</span><span class="shelf-confirmed-title" data-copy="thrillerBooks">Troyee Rohoshyo · Sher Afganer Tarabari</span><span class="tile-bottom" data-copy="viewThrillers">View published thrillers <b aria-hidden="true">↗</b></span></a>
        <a class="shelf-tile shelf-horror" asp-page="/Books" asp-route-category="Horror"><span class="tile-number" data-copy="fictionFour">04 / FICTION</span><span class="tile-title" data-copy="horror">Horror</span><span class="shelf-confirmed-title" data-copy="rotiroktoTitle">Rotirokto</span><span class="tile-bottom" data-copy="viewHorror">View horror <b aria-hidden="true">↗</b></span></a>
    </div>
</section>

<section class="upcoming-band" aria-labelledby="upcoming-title">
    <div class="wrap upcoming-inner">
        <div class="upcoming-index">NEXT<br />CHAPTER<br /><span>→</span></div>
        <div><p class="eyebrow" data-copy="upcomingEyebrow">On the horizon</p><h2 id="upcoming-title" data-copy="upcomingTitle">Upcoming books</h2><p data-copy="upcomingBody">Release information will appear here after it is confirmed for public announcement.</p></div>
        <span class="status-outline" data-copy="detailsPendingBadge">DETAILS PENDING</span>
    </div>
</section>

<section class="section wrap author-section" id="about" aria-labelledby="author-title">
    <div class="author-number">01<br /><span>—</span></div>
    <div class="author-copy author-bio">
        <p class="eyebrow" data-copy="aboutEyebrow">A little about the author</p>
        <h2 id="author-title" data-copy="bioLead">A bilingual author.<br /><em>Mysteries from Bengal’s forgotten past.</em><br />Ideas for leading in the age of AI.</h2>
        <p class="bio-standfirst" data-copy="bioStandfirst">I write about the things we accept without checking.</p>
        <p data-copy="bioOpening">In my fiction, that means erased history, coded manuscripts and folk beliefs that outlived their origins. In my work as a technologist, it means AI systems that people trust faster than they understand. In leadership, it means the habits and inherited assumptions that quietly steer decisions.</p>
        <p data-copy="bioQuestion">The setting changes. The question doesn’t: <em>who decided this was true, and what did they leave out?</em></p>
        <div class="bio-divider"></div>
        <h3 data-copy="bioMysteryHeading">Mystery fiction, in Bengali and English</h3>
        <p data-copy="bioMystery">Professor Arin Roy is my longest-running investigator, with nine books published in Bengali, including <em>Rotirokto</em> and <em>Troyee Rohoshyo</em>. He starts with a small question and ends up somewhere he never planned to go.</p>
        <p data-copy="bioUpcomingMysteries">New mysteries are coming:</p>
        <ul class="bio-list">
            <li data-copy="bioUpcomingOne"><em>Neel Kacher Rohoshyo</em>, introducing Detective Abhinab</li>
            <li data-copy="bioUpcomingTwo"><em>Matir Khuda</em>, the first Aghornath story, an occult horror</li>
            <li data-copy="bioUpcomingThree"><em>Boxar Projapoti Rohoshyo</em>, a treasure adventure set during the Second World War</li>
        </ul>
        <div class="bio-divider"></div>
        <h3 data-copy="bioAiHeading">AI and leadership, in English</h3>
        <p data-copy="bioAi"><em>The AI Circuit Breaker</em> is about the leadership skill AI makes urgent: knowing when to pause, question and keep human judgment in charge.</p>
        <p data-copy="bioUpcomingAi">Coming next:</p>
        <ul class="bio-list">
            <li data-copy="bioUpcomingAiOne"><em>AI Augmented Students</em></li>
            <li data-copy="bioUpcomingAiTwo"><em>AI to SI: The Super Intelligence Journey</em></li>
            <li data-copy="bioUpcomingAiThree"><em>A Practical Leadership Guide</em></li>
        </ul>
        <p data-copy="bioLeadership">I write from inside the technology industry, and from ordinary life: a decision at home, a hallway conversation, a bad week. That is where leaders are actually formed.</p>
        <div class="bio-divider"></div>
        <h3 data-copy="bioStartHeading">Start here</h3>
        <p><strong data-copy="bioStartMysteryLabel">New to my fiction?</strong> <span data-copy="bioStartMystery">Begin with Professor Arin Roy’s adventures, <em>Rotirokto</em> and <em>Troyee Rohoshyo</em>.</span></p>
        <p><strong data-copy="bioStartAiLabel">Leading through AI?</strong> <a class="bio-inline-link" href="https://www.amazon.com/dp/B0GZCVB17F" target="_blank" rel="noopener noreferrer"><em>The AI Circuit Breaker</em> <span aria-hidden="true">↗</span></a></p>
        <p><strong data-copy="bioStartNewsletter">Want new releases first?</strong> <span data-copy="newsletterPending">Newsletter signup will be added when the mailing-list service is connected.</span></p>
        <p class="bio-location" data-copy="bioLocation">I live in the United States. My stories keep returning to Bengal.</p>
        <span class="signature" data-copy="authorSignature">Subhajit Ghosh</span>
    </div>
    <div class="testimonial-note"><span class="quote-mark">“</span><p data-copy="testimonialPending">A space for reader testimonials. Approved quotes and permissions will be added later.</p><span class="testimonial-label" data-copy="testimonialLabel">READER NOTES · RESERVED</span></div>
</section>

<section class="faq-section" id="faq" aria-labelledby="faq-title">
    <div class="wrap faq-layout">
        <div class="faq-intro"><p class="eyebrow" data-copy="faqEyebrow">A small book guide</p><h2 id="faq-title" data-copy="faqTitle">Curious?<br /><em>Ask away.</em></h2><p data-copy="faqIntro">This FAQ finder answers only from information currently confirmed on this site. It is an automated guide, not Subhajit.</p><span class="bot-label"><span class="bot-dot"></span><span data-copy="botStatus">FAQ FINDER · EARLY PREVIEW</span></span></div>
        <div class="faq-panel">
            <div class="faq-messages" id="faq-messages" aria-live="polite" aria-relevant="additions">
                <p class="bot-message" data-copy="faqWelcome">Hello. Ask what genres Subhajit writes in, about The AI Circuit Breaker, or where to find its purchase link. Other book details will be added when confirmed.</p>
            </div>
            <form id="faq-form" class="faq-form">
                <label class="visually-hidden" for="faq-input" data-copy="faqLabel">Ask the book guide</label>
                <input id="faq-input" name="question" maxlength="240" autocomplete="off" placeholder="Ask about genres or books…" data-placeholder="faqPlaceholder" />
                <button class="send-button" type="submit" aria-label="Send question"><span aria-hidden="true">↑</span></button>
            </form>
            <p class="faq-disclaimer" data-copy="faqDisclaimer">No private messages are used. The guide will say when it doesn’t know.</p>
        </div>
    </div>
</section>

<section class="contact-band wrap" id="contact" aria-labelledby="contact-title">
    <div><p class="eyebrow" data-copy="contactEyebrow">For readers</p><h2 id="contact-title" data-copy="contactTitle">Let’s keep<br />the conversation open.</h2></div>
    <div class="contact-note"><p data-copy="contactPending">For reader inquiries, email:</p><a class="contact-email" href="mailto:sgresearchauthorrepo@gmail.com">sgresearchauthorrepo@gmail.com</a></div>
</section>
