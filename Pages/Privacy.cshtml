@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy | Subhajit Ghosh";
}

<section class="privacy-page wrap">
    <p class="eyebrow" data-copy="privacyEyebrow">A clear note</p>
    <h1 data-copy="privacyTitle">Privacy<span>.</span></h1>
    <p class="privacy-lead" data-copy="privacyIntro">This site is an early preview. Reader services will be activated only after their providers and privacy terms are confirmed.</p>
    <div class="privacy-copy">
        <h2 data-copy="languageStorageTitle">Language preference</h2>
        <p data-copy="languageStorageBody">The language switch stores your English or Bengali preference in this browser’s local storage. It is not sent to the website.</p>
        <h2 data-copy="faqPrivacyTitle">Book FAQ finder</h2>
        <p data-copy="faqPrivacyBody">Questions are answered locally in your browser from a small set of confirmed facts. They are not sent to an AI service or saved by this site. The answer area clears when you leave or reload the page.</p>
        <h2 data-copy="inactiveServicesTitle">Services not connected</h2>
        <p data-copy="inactiveServicesBody">Contact messages, newsletter signups, and book purchases are not processed by this preview. No message or subscription form is currently active.</p>
        <h2 data-copy="hostingLogsTitle">Hosting and technical logs</h2>
        <p data-copy="hostingLogsBody">When the site is hosted publicly, the hosting provider may process technical request logs under its own terms. Hosting and analytics choices should be reviewed and this notice updated before launch.</p>
        <p class="privacy-updated" data-copy="privacyUpdated">Preview notice · October 2026</p>
    </div>
</section>
